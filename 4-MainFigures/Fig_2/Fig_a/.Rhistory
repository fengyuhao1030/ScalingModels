dataMatrix <- read.csv('D:/Theoretical/1-Synchronous R-rw (Negative)/Synchronous strategy (Negative).csv')
selectIDs <- which(is.na(dataMatrix$rw))
dataMatrix <- dataMatrix[selectIDs,]
A <- as.numeric(dataMatrix$TotalP)
# # 序列 B：单峰
# B <- rnorm(n, mean = 0, sd = 1)
dataMatrix <- read.csv('D:/Theoretical/1-Asynchronous R-rw/Asynchronous strategy.csv')
selectIDs <- which(dataMatrix$rw == 0.1)
dataMatrix <- dataMatrix[selectIDs,]
B <- as.numeric(dataMatrix$TotalP)
compute_wss <- function(x, k, nstart = 20) {
km <- kmeans(x, centers = k, nstart = nstart)
km$tot.withinss
}
gap_statistic_1vs2 <- function(x, B = 200) {
compute_wss <- function(x, k, nstart = 20) {
kmeans(x, centers = k, nstart = nstart)$tot.withinss
}
# 真实数据
wss1_obs <- compute_wss(x, 1)
wss2_obs <- compute_wss(x, 2)
delta_obs <- log(wss1_obs) - log(wss2_obs)
# 参考数据
xmin <- min(x)
xmax <- max(x)
n <- length(x)
delta_ref <- numeric(B)
for (b in 1:B) {
x_ref <- runif(n, xmin, xmax)
wss1_ref <- compute_wss(x_ref, 1)
wss2_ref <- compute_wss(x_ref, 2)
delta_ref[b] <- log(wss1_ref) - log(wss2_ref)
}
delta_ref_mean <- mean(delta_ref)
delta_ref_sd   <- sd(delta_ref)
se <- delta_ref_sd * sqrt(1 + 1/B)
list(
delta_obs = delta_obs,
delta_ref_mean = delta_ref_mean,
delta_ref_sd = delta_ref_sd,
se = se,
significant = delta_obs > delta_ref_mean + se
)
}
gap_A <- gap_statistic_1vs2(A)
gap_B <- gap_statistic_1vs2(B)
gap_A
gap_B
