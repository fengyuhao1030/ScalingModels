ImprovedAbsDiff <- abs(mean(dataMatrix$PredictLambda - dataMatrix$SPAMLambda))
multiplyValues <- (dataMatrix$PredictLambda - dataMatrix$SPAMLambdaDown)*(dataMatrix$PredictLambda - dataMatrix$SPAMLambdaUp)
selectIDs <- which(multiplyValues < 0)
ImprovedNum <- length(selectIDs)
drawMatrix <- rbind(drawMatrix,data.frame(ParameterID = 3,TheoryID = 4,AbsDiff = ImprovedAbsDiff,Num = ImprovedNum))
##==== Lambda ====##
drawMatrix$SiteID <- 4
write.csv(drawMatrix,'Agreement_GTS.csv',row.names = FALSE)
