model{

    for(i in 1:Size){
		Y[i,1] <- logMaxPathLength[i]
        Y[i,2] <- logVolume[i]
        Y[i,3] <- logTipNum[i]
        Y[i,1:3] ~ dmnorm(mu[i,1:3],sigma[1:3,1:3])
        mu[i,1] <- C1Tree[TreeID[i]] + etaTree[TreeID[i]]*logRadius[i]
        mu[i,2] <- C2Tree[TreeID[i]] + faiTree[TreeID[i]]*logRadius[i]
        mu[i,3] <- C3Tree[TreeID[i]] + lambdaTree[TreeID[i]]*logRadius[i]
    }
	
	# Hyper-prior for sigmaY
	sigma[1:3,1:3] ~ dwish(R[1:3,1:3],3)

    # Hyper-prior for c1, c2, c3
    for(t in 1:TreeNum){
        C1Tree[t] ~ dnorm(C1Species[SpID[t]],sigmaC1)
        C2Tree[t] ~ dnorm(C2Species[SpID[t]],sigmaC2)
        C3Tree[t] ~ dnorm(C3Species[SpID[t]],sigmaC3)
    }
    sigmaC1 ~ dgamma(0.01,0.001)
    sigmaC2 ~ dgamma(0.01,0.001)
    sigmaC3 ~ dgamma(0.01,0.001)
    for(s in 1:SpNum){
        C1Species[s] ~ dnorm(muC1,sigmaC4)
        C2Species[s] ~ dnorm(muC2,sigmaC5)
        C3Species[s] ~ dnorm(muC3,sigmaC6)
    }
    muC1 ~ dnorm(0,0.00001)
    muC2 ~ dnorm(0,0.00001)
    muC3 ~ dnorm(0,0.00001)
    sigmaC4 ~ dgamma(0.01,0.001)
    sigmaC5 ~ dgamma(0.01,0.001)
    sigmaC6 ~ dgamma(0.01,0.001)
	
	# Hyper-prior for etaTree, faiTree, and lambdaTree
	for(t in 1:TreeNum){
		etaTree[t] <- 2/3 + 0.0098*CDI[t] + 0.4183*(3-BoxD[t]) - 0.0027*(83-MBO[t])
		faiTree[t] <- 8/3 + 0.0020*CDI[t] - 0.1206*(3-BoxD[t]) - 0.0028*(83-MBO[t])
		lambdaTree[t] <- 2 + 0.0305*CDI[t] - 0.0116*(83-MBO[t])
	}

}